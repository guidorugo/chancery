# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/

# Environment variables
.env

# Docker secrets (e.g. the master passphrase file)
secrets/

# Key material and exported bundles must never be committed (G19-2)
*.pem
*.key
*.p12
*.pfx

# Bring-your-own TLS cert/key mounted into Caddy (see deploy/Caddyfile)
deploy/tls/

# Local compose overrides (site-specific tweaks). SoftHSM is enabled by default
# in docker-compose.yml, so no override is needed just to turn it on.
docker-compose.override.yml

# Database
data/
instance/

# IDE
.vscode/
.idea/

# Local Claude Code settings (per-developer; not shared config)
.claude/

# pytest
.pytest_cache/

# OS
.DS_Store

# dns-01 example: generated TSIG secret + rendered BIND config (examples/acme-dns01/setup.sh)
examples/acme-dns01/named.conf
examples/acme-dns01/tsig.secret
examples/acme-dns01/tsig.key
