SECRET_KEY=change-me-to-a-random-secret-key
# In Docker, prefer the file form so the key stays out of `docker inspect`:
# SECRET_KEY_FILE=/run/secrets/secret_key   (see the G2-1 note in docker-compose.yml)
# MASTER_PASSPHRASE: for docker-compose this is delivered as a Docker secret
# (secrets/master_passphrase), NOT this env var. For local (non-docker) dev you
# may set it here, or point MASTER_PASSPHRASE_FILE at a file. SECRET_KEY and
# ADMIN_PASSWORD support the same *_FILE convention.
# MASTER_PASSPHRASE=change-me-to-a-strong-passphrase
DATABASE_URL=sqlite:///data/cert-manager.db
ADMIN_USERNAME=admin
# ADMIN_PASSWORD seeds the FIRST admin only (when the database has no users).
# You must change it on first login (the app forces it), after which this value
# is unused and can be deleted from .env. It is only re-read if the database is
# ever reset to zero users.
ADMIN_PASSWORD=admin

# --- Transport / hardening (1.1.0) ---
# Secure cookies (send only over HTTPS). Code default is true; the reference
# HTTP compose overrides to false. Set true once a TLS proxy is in front.
# SESSION_COOKIE_SECURE=true
# Number of trusted reverse-proxy hops (0 = directly exposed). Set to 1 behind
# a single TLS-terminating proxy so audit/rate-limit see the real client IP.
# TRUSTED_PROXY_COUNT=1
# C4: hostname baked into issued certs' OCSP/CRL URLs (permanent). Pin this in
# production; while unset it is auto-detected from the request Host header.
# SERVER_NAME_FOR_OCSP=ca.example.com
# E1: hostname for the TLS reverse-proxy example (deploy/docker-compose.tls.yml).
# PUBLIC_HOSTNAME=ca.example.com
# E3: startup refuses cleartext ldap:// unless explicitly allowed here.
# LDAP_ALLOW_PLAINTEXT=false
# D1: lock a local account after N consecutive failed logins for M minutes
# (session login + Basic Auth). Threshold 0 disables lockout.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15

# Two-factor authentication (TOTP). REQUIRE_2FA forces enrolment: "admins" for
# administrators, "all" for every account, "off" (default) leaves it optional.
# Enrol yourself BEFORE turning it on: the next login of every affected user
# goes seed/current password -> (new password on first login) -> enrol an
# authenticator -> app, and Basic Auth is refused until they have enrolled
# (use API tokens for scripts). A lost authenticator is recovered with a
# recovery code, or an admin reset (user edit page /
# `docker compose exec -u app app flask users reset-2fa <user>`).
# REQUIRE_2FA=off
# TOTP_ISSUER=Chancery

# --- Issuance policy (1.1.0) ---
# MAX_CERT_VALIDITY_DAYS=1825            # hard cap on leaf-cert validity (5 years; also clamped to the CA)
# MAX_INTERMEDIATE_VALIDITY_DAYS=3650    # hard cap on intermediate-CA validity (10 years)
# MAX_CA_VALIDITY_DAYS=7300              # hard cap on root-CA validity (20 years)
# MIN_RSA_KEY_SIZE=2048           # reject weaker RSA keys
# MAX_RSA_KEY_SIZE=8192           # reject larger RSA keys (keygen cost; G7-1)
# PROFILES_REQUIRE_SELECTION=false # true = every issuance must name a certificate profile
# OCSP_KEY_CACHE_TTL_SECONDS=300  # cache decrypted CA key for OCSP (0 disables)
# MAX_CONTENT_LENGTH_BYTES=1048576
# CERT_EXPIRY_WARNING_DAYS=30     # flag certs/CAs "expiring soon" this many days out
# SCHEDULER_ENABLED=true          # built-in scheduler (CRL refresh before expiry); false = rely on `flask crl refresh`
# SCHEDULER_TICK_SECONDS=60       # scheduler pass interval
# CRL_REFRESH_BEFORE_DAYS=2       # regenerate a CRL once it expires within this many days
# PUBLIC_RATE_LIMIT=600/minute    # per-IP limit for the public CRL/OCSP endpoints
#                                 # (dashboard counts, badges, JSON API, `flask certs expiring`)

# --- SoftHSM / PKCS#11 key backend (2.0, finding A1) ---
# Store CA signing keys in a PKCS#11 token (non-exportable) instead of encrypted
# files. The Docker image bundles softhsm2; the entrypoint initialises the token
# when SOFTHSM2_CONF is set. User/SO PINs use the *_FILE secret convention.
# KEY_BACKEND=software            # default for NEW CAs (software|softhsm)
# PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
# PKCS11_TOKEN_LABEL=cert-manager
# SOFTHSM2_CONF=/app/data/softhsm/softhsm2.conf
# PKCS11_USER_PIN_FILE=/run/secrets/pkcs11_user_pin
# PKCS11_SO_PIN_FILE=/run/secrets/pkcs11_so_pin
# Even with KEY_BACKEND=software, providing these makes HSM selectable per-CA in
# the create form. Move existing keys in with: flask keys migrate-to-hsm

# LDAP authentication (optional). Direct-bind mode:
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldaps://ldap.example.com:636
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# ...or search+bind mode (instead of LDAP_USER_DN_TEMPLATE):
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_BIND_DN=cn=svc-certmgr,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=service-account-password
# Group-to-role mapping (DNs; requester group also gates access when set):
# LDAP_ADMIN_GROUP_DN=cn=cert-admins,ou=groups,dc=example,dc=com
# LDAP_REQUESTER_GROUP_DN=cn=cert-requesters,ou=groups,dc=example,dc=com
# LDAP_CA_CERT_FILE=/path/to/ldap-ca.pem
# Basic Auth credential cache TTL in seconds (0 disables):
# BASIC_AUTH_CACHE_TTL_SECONDS=60

# --- Update check (footer "Update available" badge) ---
# ON by default: the latest GitHub release tag is fetched server-side (cached,
# non-blocking) and compared to the running version; a badge links to the
# release when a newer one exists. Set false for an air-gapped CA that must make
# no outbound call.
# UPDATE_CHECK_ENABLED=false
# UPDATE_CHECK_REPO=guidorugo/chancery   # override for a fork
# UPDATE_CHECK_INTERVAL_SECONDS=21600        # cache TTL (default 6h)

# --- Prometheus /metrics endpoint (2.7.0; opt-in, off by default) ---
# METRICS_ENABLED=true                        # expose GET /metrics (404 until enabled)
# METRICS_ALLOW_UNAUTHENTICATED=true          # skip the bearer token (isolated networks only)
# METRICS_INCLUDE_CA_DETAILS=true             # add a ca_info metric exposing CA names/CNs/key details
# Manage bearer tokens with:  flask metrics-token create --name prometheus --expires-in-days 90

# --- Dual control (2.10.0; opt-in, off by default) ---
# With the flag on, the restrictions apply only while the instance is genuinely
# multi-user (another active account besides ADMIN_USERNAME, or LDAP in effect):
# direct certificate creation is disabled (CSR flow enforced), a CSR's creator
# cannot sign it, and a new CA must be approved by a different admin before it
# can issue anything. The literal ADMIN_USERNAME account is exempt (break-glass).
# DUAL_CONTROL_ENABLED=true

# --- Webhook notifications (2.10.0; opt-in, off by default) ---
# Selected audit actions are POSTed as JSON to the URL (fire-and-forget,
# fail-silent). Configurable from the admin UI (Preferences -> Webhooks) too —
# settings saved there override these variables until removed.
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=https://n8n.example.com/webhook/chancery
# WEBHOOK_SECRET=change-me                   # optional; HMAC-SHA256 body signature
# WEBHOOK_EVENTS=sign_csr,create_ca,revoke_certificate   # CSV; "all" = everything
# WEBHOOK_TIMEOUT_SECONDS=5

# ACME server (RFC 8555; certbot, acme.sh, lego, Caddy). Off by default. Turn it
# on here, then enable it per CA on the CA page (choose the profile and whether
# an external account binding key is required — default yes). Clients use
# http(s)://<host>/acme/<ca_id>/directory; ACME_BASE_URL pins that base when the
# server sits behind a proxy under another name.
# ACME_ENABLED=false
# ACME_BASE_URL=https://ca.example.lan
# ACME_DEFAULT_VALIDITY_DAYS=90
# dns-01 (3.6.0): the DNS servers asked for _acme-challenge TXT records (all must
# agree; empty = the container's resolver). Point it at the authoritative server
# so no cache sits in between — examples/acme-dns01/ ships one. Wildcard names
# are a per-CA switch on the CA page.
# ACME_CHALLENGE_TYPES=http-01,dns-01
# ACME_DNS_RESOLVERS=10.0.0.53
# ACME_DNS01_MAX_ATTEMPTS=10
# ACME_DNS01_RETRY_SECONDS=10


# Audit-log retention (F16). 0 keeps every row; otherwise sealed rows older than
# this many days are archived as JSON lines under AUDIT_ARCHIVE_DIR (default
# data/audit-archive) and deleted behind a checkpoint that keeps the hash chain
# verifiable (`flask audit verify`).
# AUDIT_RETENTION_DAYS=0

# Dual control (four-eyes). With DUAL_CONTROL_ENABLED=true and a second active
# account, issuance and (since 3.4.0) user management need two admins; an
# account created or reset by admin X cannot approve X's work for this long.
# DUAL_CONTROL_ENABLED=false
# DUAL_CONTROL_COOLDOWN_HOURS=24

# gunicorn HTTP access log on stdout (path without query string, status, latency).
# ACCESS_LOG=true
