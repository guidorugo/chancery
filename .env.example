SECRET_KEY=change-me-to-a-random-secret-key
# MASTER_PASSPHRASE: for docker-compose this is delivered as a Docker secret
# (secrets/master_passphrase), NOT this env var. For local (non-docker) dev you
# may set it here, or point MASTER_PASSPHRASE_FILE at a file. SECRET_KEY and
# ADMIN_PASSWORD support the same *_FILE convention.
# MASTER_PASSPHRASE=change-me-to-a-strong-passphrase
DATABASE_URL=sqlite:///data/cert-manager.db
ADMIN_USERNAME=admin
# ADMIN_PASSWORD seeds the FIRST admin only (when the database has no users).
# You must change it on first login (the app forces it), after which this value
# is unused and can be deleted from .env. It is only re-read if the database is
# ever reset to zero users.
ADMIN_PASSWORD=admin

# --- Transport / hardening (1.1.0) ---
# Secure cookies (send only over HTTPS). Code default is true; the reference
# HTTP compose overrides to false. Set true once a TLS proxy is in front.
# SESSION_COOKIE_SECURE=true
# Number of trusted reverse-proxy hops (0 = directly exposed). Set to 1 behind
# a single TLS-terminating proxy so audit/rate-limit see the real client IP.
# TRUSTED_PROXY_COUNT=1
# C4: hostname baked into issued certs' OCSP/CRL URLs (permanent). Pin this in
# production; while unset it is auto-detected from the request Host header.
# SERVER_NAME_FOR_OCSP=ca.example.com
# E1: hostname for the TLS reverse-proxy example (deploy/docker-compose.tls.yml).
# PUBLIC_HOSTNAME=ca.example.com
# E3: startup refuses cleartext ldap:// unless explicitly allowed here.
# LDAP_ALLOW_PLAINTEXT=false
# D1: lock a local account after N consecutive failed logins for M minutes
# (session login + Basic Auth). Threshold 0 disables lockout.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Issuance policy (1.1.0) ---
# MAX_CERT_VALIDITY_DAYS=825      # hard cap on leaf-cert validity
# MAX_CA_VALIDITY_DAYS=7305       # hard cap on CA validity
# MIN_RSA_KEY_SIZE=2048           # reject weaker RSA keys
# OCSP_KEY_CACHE_TTL_SECONDS=300  # cache decrypted CA key for OCSP (0 disables)
# MAX_CONTENT_LENGTH_BYTES=1048576
# CERT_EXPIRY_WARNING_DAYS=30     # flag certs/CAs "expiring soon" this many days out
#                                 # (dashboard counts, badges, JSON API, `flask certs expiring`)

# --- SoftHSM / PKCS#11 key backend (2.0, finding A1) ---
# Store CA signing keys in a PKCS#11 token (non-exportable) instead of encrypted
# files. The Docker image bundles softhsm2; the entrypoint initialises the token
# when SOFTHSM2_CONF is set. User/SO PINs use the *_FILE secret convention.
# KEY_BACKEND=software            # default for NEW CAs (software|softhsm)
# PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
# PKCS11_TOKEN_LABEL=cert-manager
# SOFTHSM2_CONF=/app/data/softhsm/softhsm2.conf
# PKCS11_USER_PIN_FILE=/run/secrets/pkcs11_user_pin
# PKCS11_SO_PIN_FILE=/run/secrets/pkcs11_so_pin
# Even with KEY_BACKEND=software, providing these makes HSM selectable per-CA in
# the create form. Move existing keys in with: flask keys migrate-to-hsm

# LDAP authentication (optional). Direct-bind mode:
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldaps://ldap.example.com:636
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# ...or search+bind mode (instead of LDAP_USER_DN_TEMPLATE):
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(uid={username})
# LDAP_BIND_DN=cn=svc-certmgr,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=service-account-password
# Group-to-role mapping (DNs; requester group also gates access when set):
# LDAP_ADMIN_GROUP_DN=cn=cert-admins,ou=groups,dc=example,dc=com
# LDAP_REQUESTER_GROUP_DN=cn=cert-requesters,ou=groups,dc=example,dc=com
# LDAP_CA_CERT_FILE=/path/to/ldap-ca.pem
# Basic Auth credential cache TTL in seconds (0 disables):
# BASIC_AUTH_CACHE_TTL_SECONDS=60

# --- Update check (footer "Update available" badge) ---
# ON by default: the latest GitHub release tag is fetched server-side (cached,
# non-blocking) and compared to the running version; a badge links to the
# release when a newer one exists. Set false for an air-gapped CA that must make
# no outbound call.
# UPDATE_CHECK_ENABLED=false
# UPDATE_CHECK_REPO=guidorugo/cert-manager   # override for a fork
# UPDATE_CHECK_INTERVAL_SECONDS=21600        # cache TTL (default 6h)
